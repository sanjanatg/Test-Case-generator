# Copy this file to .env and set LLM_PROVIDER plus the matching provider values.
# Supported presets: OpenAI, Gemini, Ollama, Custom OpenAI-compatible
LLM_PROVIDER=OpenAI

# OpenAI preset
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini preset (Google AI Studio key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Ollama preset (local; no real key required)
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1

# Custom OpenAI-compatible server, such as a local vLLM or llama.cpp endpoint
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=http://localhost:8000/v1
